function fetchOrderBooksForAllPairs() {
  const pairs = [
    "USDTIRT",
    "BTCIRT",
    "BTCUSDT",
    "PAXGUSDT",
    "PAXGIRT",
    "XAUTUSDT",
    "XAUTIRT",
    "ETHUSDT",
    "BNBUSDT",
    "XRPUSDT",
    "TONUSDT",
    "DOGEUSDT",
    "TRXUSDT"
  ];
  
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();

  pairs.forEach(function(pair) {
    const sheet = spreadsheet.getSheetByName(pair);
    if (!sheet) {
      Logger.log("Sheet not found: " + pair);
      return;
    }

    const url = `https://apiv2.nobitex.ir/v3/orderbook/${pair}`;
    const response = UrlFetchApp.fetch(url);
    const data = JSON.parse(response.getContentText());

    if (data.status !== "ok") {
      sheet.getRange("A1").setValue("Error fetching data");
      return;
    }

    const now = new Date();

    // Headers
    sheet.getRange("A1:D1").setValues([["side", "timestamp", "amount", "price"]]);
    sheet.getRange("F1:I1").setValues([["side", "timestamp", "amount", "price"]]);
    sheet.getRange("B:B").setNumberFormat("yyyy/MM/dd HH:mm:ss");
    sheet.getRange("G:G").setNumberFormat("yyyy/MM/dd HH:mm:ss");

    // Bids
    const bidRows = data.bids.slice(0, 10).map(bid => ["buy", now, bid[1], bid[0]]);
    if (bidRows.length > 0) {
      sheet.getRange(2, 1, bidRows.length, 4).clearContent();
      sheet.getRange(2, 1, bidRows.length, 4).setValues(bidRows);
    }

    // Asks
    const askRows = data.asks.slice(0, 10).map(ask => ["sell", now, ask[1], ask[0]]);
    if (askRows.length > 0) {
      sheet.getRange(2, 6, askRows.length, 4).clearContent();
      sheet.getRange(2, 6, askRows.length, 4).setValues(askRows);
    }
  });
}
